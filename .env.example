# Documentation template; start.sh reads exported environment variables, not this file.
# CloudStudio: sh start.sh --cloud
PORT=8000
MARKET_HOST=0.0.0.0
# Optional: exact HTTPS preview origin if the platform does not provide X_IDE_SPACE_*.
# MARKET_PUBLIC_ORIGIN=https://your-exact-preview-host.example
# Keep runtime data in a persistent directory outside Git.
# MARKET_DATA_DIR=/workspace/xishi-data
# HTTPS preview requires secure session cookies. Use 0 only for local HTTP testing.
COOKIE_SECURE=1
# Administrator creation is a separate explicit step; never commit its password.
