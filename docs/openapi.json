  "components": {
    "schemas": {
      "Body_upload_api_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_uploads_post"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageInput": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Content"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "MessageInput"
      },
      "ProductInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 5,
            "title": "Description"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 999999.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "image_url": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Image Url"
          },
          "contact": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Contact"
          },
          "location": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Location"
          },
          "condition": {
            "type": "string",
            "enum": [
              "全新",
              "几乎全新",
              "轻微使用",
              "正常使用"
            ],
            "title": "Condition",
            "default": "轻微使用"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description",
          "price",
          "category",
          "image_url",
          "contact",
          "location"
        ],
        "title": "ProductInput"
      },
      "Registration": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 30,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "nickname": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Nickname"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password",
          "nickname"
        ],
        "title": "Registration"
      },
      "SearchHistoryInput": {
        "properties": {
          "keyword": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Keyword"
          }
        },
        "type": "object",
        "required": [
          "keyword"
        ],
        "title": "SearchHistoryInput"
      },
      "StatusInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "on_sale",
              "off_shelf",
              "sold"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
